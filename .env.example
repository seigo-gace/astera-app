VITE_ASTERA_API_BASE=https://api.asterav8.jp
# Better Auth baseURL 用（絶対 http(s) のみ。相対 `/api` は Better Auth baseURL に使わない）
VITE_BETTER_AUTH_URL=https://staging.asterav8.jp
VITE_APP_URL=https://staging.asterav8.jp
# staging/dev UI preview 専用。production では true にしない
VITE_PREVIEW_WITHOUT_AUTH=false
# ローカル: .env.local で VITE_ASTERA_API_BASE=/api を proxy 用に上書き可（build 時も読む。auth-client / resolvedApiBase は相対を無視）
VITE_ASTERA_HP_URL=https://asterav8.jp/
VITE_SUPPORT_DEVELOPMENT_URL=https://asterav8.jp/support/development
VITE_SUPPORT_CROWDFUNDING_URL=https://asterav8.jp/support/crowdfunding
VITE_SUPPORT_PARTNERSHIP_URL=https://asterav8.jp/support/partnership
# Cloudflare Pages Functions: customer-ai upstream proxy (server-side only)
CUSTOMER_AI_UPSTREAM=
CUSTOMER_AI_HF_TOKEN=
