# Translation engine has no provider/API credentials. It is loopback-only and offline at runtime.
ASTERA_TRANSLATION_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHAR_TOKEN
ASTERA_TRANSLATION_MODEL_PATH=/models/madlad400-3b-mt-ct2
ASTERA_TRANSLATION_BIND=127.0.0.1
ASTERA_TRANSLATION_INTER_THREADS=1
ASTERA_TRANSLATION_INTRA_THREADS=2
ASTERA_TRANSLATION_MAX_CONCURRENCY=1
ASTERA_TRANSLATION_BEAM_SIZE=4
PORT=8792
