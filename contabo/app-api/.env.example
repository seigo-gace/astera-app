# Non-secret shape only. Copy real values into the server Secret store; do not commit real values.
PORT=8788
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
ASTERA_PROCESS_ORIGIN=https://internal-astera-runtime.example.invalid
ASTERA_PROCESS_TOKEN=REPLACE_WITH_RUNTIME_TOKEN
ASTERA_PROCESS_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=20000

# Libral-Vault internal adapter. Provider keys and encryption keys are stored in Libral-Vault;
# Astera App receives only Vault references.
LIBRAL_VAULT_INTERNAL_ORIGIN=http://127.0.0.1:8791
LIBRAL_VAULT_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
LIBRAL_VAULT_JOB_KEY_REF=REPLACE_WITH_VAULT_SECRET_REFERENCE
LIBRAL_VAULT_GEMINI_KEY_REF=REPLACE_WITH_VAULT_SECRET_REFERENCE
LIBRAL_VAULT_TIMEOUT_MS=15000

# TGserver Astera App User Storage Lane. Keep System Log and User Storage lanes separate.
TGS_STORAGE_INTERNAL_ORIGIN=http://127.0.0.1:3000
TGS_STORAGE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
TGS_STORAGE_TIMEOUT_MS=600000

# Storage deletion lifecycle. The App API signs an internal request to the authenticated
# Cloudflare Pages lifecycle endpoint every 5 minutes. The same INTERNAL_SERVICE_TOKEN is
# already paired with Pages APP_API_SERVICE_TOKEN; no additional secret is required.
ASTERA_STORAGE_LIFECYCLE_ORIGIN=https://staging.asterav8.jp
ASTERA_STORAGE_LIFECYCLE_INTERVAL_MS=300000
ASTERA_STORAGE_LIFECYCLE_TIMEOUT_MS=60000

# Actual Gemini model ID is deployment configuration, not a Frontend hardcode.
# Current stable Flash-Lite deployment profile (2026-08): gemini-3.5-flash-lite.
ASTERA_TRANSLATION_MODEL_ID=gemini-3.5-flash-lite
ASTERA_TRANSLATION_TIMEOUT_MS=90000
