# Non-secret shape only. Copy real values into the server Secret store; do not commit real values.
PORT=8788
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
ASTERA_PROCESS_ORIGIN=https://internal-astera-runtime.example.invalid
ASTERA_PROCESS_TOKEN=REPLACE_WITH_RUNTIME_TOKEN
ASTERA_PROCESS_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=20000

# Libral-Vault internal adapter. Encryption/job keys remain in Libral-Vault.
# Translation does not use Gemini or any external translation provider credential.
LIBRAL_VAULT_INTERNAL_ORIGIN=http://127.0.0.1:8791
LIBRAL_VAULT_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
LIBRAL_VAULT_JOB_KEY_REF=REPLACE_WITH_VAULT_SECRET_REFERENCE
LIBRAL_VAULT_TIMEOUT_MS=15000

# TGserver Astera App User Storage Lane. Keep System Log and User Storage lanes separate.
TGS_STORAGE_INTERNAL_ORIGIN=http://127.0.0.1:3000
TGS_STORAGE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
TGS_STORAGE_TIMEOUT_MS=600000

# Shared local AI Core. Translation is fixed to Qwen3 through the Router; never use backend ports directly.
AI_CORE_BASE_URL=http://127.0.0.1:18080
AI_CORE_API_KEY=REPLACE_WITH_AI_CORE_ROUTER_API_KEY
ASTERA_TRANSLATION_TIMEOUT_MS=90000
