# Non-secret shape only. Copy values into the server Secret store; do not commit real values.
PORT=8788
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/astera_app?sslmode=require
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
ASTERA_PROCESS_ORIGIN=https://internal-astera-runtime.example.invalid
ASTERA_PROCESS_TOKEN=REPLACE_WITH_RUNTIME_TOKEN
# 32 random bytes encoded with Base64, e.g. `openssl rand -base64 32`.
JOB_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
ASTERA_PROCESS_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=20000
MIGRATIONS_DIR=/app/migrations
