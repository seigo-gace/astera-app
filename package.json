{
  "name": "astera-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "route:audit": "node scripts/route-audit.mjs",
    "responsive:audit": "node scripts/responsive-audit.mjs",
    "mobile:audit": "node scripts/mobile-audit.mjs",
    "platform:audit": "npm run route:audit && npm run responsive:audit && npm run mobile:audit",
    "verify": "npm run platform:audit && npm run build",
    "mobile:bootstrap": "node scripts/mobile-bootstrap.mjs",
    "mobile:sync": "npm run platform:audit && npm run build && cap sync && node scripts/configure-native-platforms.mjs && npm run mobile:audit -- --native",
    "mobile:doctor": "cap doctor",
    "android:open": "npm run mobile:sync && cap open android",
    "android:run": "npm run mobile:sync && cap run android",
    "ios:open": "npm run mobile:sync && cap open ios",
    "ios:run": "npm run mobile:sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/share": "8.0.0",
    "@capacitor/splash-screen": "8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@radix-ui/react-collapsible": "1.1.16",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-scroll-area": "1.2.14",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.12",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
