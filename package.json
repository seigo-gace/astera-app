{
  "name": "astera-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "contabo/app-api"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "brand:sync": "node scripts/fetch-official-brand-assets.mjs",
    "dev": "npm run brand:sync && vite",
    "build": "npm run brand:sync && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "contract:check": "tsc -p tsconfig.contracts.json --noEmit && npm run contabo:check",
    "contabo:check": "npm --prefix contabo/app-api run check",
    "contabo:build": "npm --prefix contabo/app-api run build",
    "contabo:test": "npm --prefix contabo/app-api run test",
    "route:audit": "node scripts/route-audit.mjs",
    "responsive:audit": "node scripts/responsive-audit.mjs",
    "device:audit": "node scripts/device-matrix-audit.mjs",
    "mobile:audit": "node scripts/mobile-audit.mjs",
    "story:audit": "node scripts/user-story-audit.mjs",
    "story:audit:strict": "node scripts/user-story-audit.mjs --strict",
    "notion:audit": "node scripts/notion-repository-audit.mjs",
    "notion:audit:strict": "node scripts/notion-repository-audit.mjs --strict",
    "platform:audit": "npm run route:audit && npm run responsive:audit && npm run device:audit && npm run mobile:audit",
    "e2e:devices": "playwright test --workers=4",
    "e2e:stories": "playwright test tests/user-journey-stories.spec.ts",
    "verify": "npm run platform:audit && npm run story:audit:strict && npm run contract:check && npm run build && npm run contabo:build && npm run contabo:test && npm run cloudflare:functions:build && npm run notion:audit:strict",
    "mobile:bootstrap": "node scripts/mobile-bootstrap.mjs",
    "mobile:sync": "npm run platform:audit && npm run story:audit:strict && npm run contract:check && npm run build && npm run notion:audit:strict && cap sync && node scripts/configure-native-platforms.mjs && npm run mobile:audit -- --native",
    "mobile:doctor": "cap doctor",
    "android:open": "npm run mobile:sync && cap open android",
    "android:run": "npm run mobile:sync && cap run android",
    "ios:open": "npm run mobile:sync && cap open ios",
    "ios:run": "npm run mobile:sync && cap run ios",
    "cloudflare:functions:build": "wrangler pages functions build functions --outdir=.wrangler/functions-build",
    "cloudflare:dev": "npm run build && wrangler pages dev dist"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/share": "8.0.0",
    "@capacitor/splash-screen": "8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@radix-ui/react-collapsible": "1.1.16",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-scroll-area": "1.2.14",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.12",
    "@better-auth/passkey": "1.6.25",
    "better-auth": "1.6.25",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "1.62.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "@better-auth/core": "1.6.25",
    "better-call": "1.3.7"
  }
}
